# Opcional. Sem isso, o sistema funciona 100% com entrada manual de odds.
# Ver https://the-odds-api.com/ para conseguir uma chave gratuita.
ODDS_API_KEY=

# Alternativa a ODDS_API_KEY: várias chaves separadas por vírgula, sem
# espaço. Usado se você tiver mais de uma conta gratuita da The Odds API —
# o sistema soma a cota de todas e troca de uma pra outra sozinho quando
# uma esgota. Se preenchida, tem prioridade sobre ODDS_API_KEY.
# Ex.: ODDS_API_KEYS=chave1,chave2,chave3
ODDS_API_KEYS=

# Opcionais. Defina os DOIS pra exigir usuário/senha (HTTP Basic Auth) em
# TODO o app — obrigatório se você for expor o app na internet (ex.: Render).
# Localmente, deixe em branco: o app funciona sem pedir senha nenhuma.
APP_USERNAME=
APP_PASSWORD=
